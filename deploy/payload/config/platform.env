# MemoFirst 設定檔（KEY=VALUE，start.bat 啟動時載入）
# 改完設定後：先 stop.bat 再 start.bat 生效

# 本機連接埠，同時也是對外網址的埠：https://主機名:<PORT>/
# tailscale serve 用同一個埠對外，不特別占用 443。
# 同一台機器裝多個平台時，每個平台改成不同值。
PORT=28470

# 管理者的 Tailscale 帳號（逗號分隔多個；install.bat 會自動填入安裝機的登入帳號）
ADMIN_LOGINS=

# 對外網址（install.bat 掛好 tailscale serve 後自動填入，供首頁顯示給同事）
PUBLIC_URL=

# 進階：自訂資料目錄（留空 = 安裝包根目錄的 data 資料夾，升級時不動資料）
DATA_DIR=
