# MemoFirst 設定（Tailscale 免密架站）

# 連接埠：serve 對外埠 = app 埠 = 網址埠（同一個數字）
PORT=28470

# 綁定位址：只綁本機回送位址，交給 tailscale serve 反代。
# 嚴禁改成 0.0.0.0（區網任何人可直連並偽造 Tailscale 身分標頭）。
HOST=127.0.0.1

# 管理者 email 名單（逗號分隔，需與 Tailscale 登入 email 一致）。
# 名單內帳號自動具管理者權限。留空則僅本機 localhost 直連為管理者。
ADMIN_LOGINS=

# 開發用：無 tailscale serve（無標頭）且非本機連線時，模擬此登入身分。
# 正式環境務必留空。
DEV_BYPASS_LOGIN=
